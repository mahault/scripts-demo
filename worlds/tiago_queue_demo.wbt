WorldInfo {
  title "TIAGo Factory - Social Layer"
  basicTimeStep 16
  contactProperties [
    ContactProperties {
      softCFM 0.0002
    }
  ]
}
Viewpoint {
  orientation -0.40 0.30 0.86 1.80
  position 0 -14 18
  follow "TIAGo_L"
}
TexturedBackground {
  texture "empty_office"
}
PointLight {
  attenuation 0 0 1
  intensity 10.8
  location -4 6 5
  castShadows TRUE
}
PointLight {
  attenuation 0 0 1
  intensity 9.6
  location 5 6 5
}

