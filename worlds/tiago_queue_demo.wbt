  stepRise 0.297
  nSteps 10
  stepAppearance PBRAppearance {
    baseColor 0.8 0.8 0.8
    roughness 0.5
    metalness 0
  }
  stringerAppearance PBRAppearance {
    baseColor 0.8 0.8 0.8
    roughness 0.5
    metalness 0
  }
  leftRail []
  rightRail [
    StraightStairsRail {
      run 3
      rise 2.97
      newelHeight 0.862
      balusterHeight 0.83
      nBalusters 12
      appearance PBRAppearance {
        baseColor 0.8 0.8 0.8
        roughness 0.5
        metalness 0
      }
    }
  ]
}

# -------------------------------------------------------------------
# Queue Script Learning Demo
#
# 3 teacher robots cycle deterministically through CUE_ markers,
# forming a visible queue. 1 learner robot observes and uses the
# repertoire learning pipeline to learn the queue script.
#
# CUE_QUEUE_HERE (yellow): queue zone at (0, -2)
# CUE_QUEUE_SERVICE (green): service counter at (3, -2)
# -------------------------------------------------------------------

# Queue zone marker (visual only — no boundingObject so robots can pass over)
Solid {
  translation 0 -2 0.01
  name "CUE_QUEUE_HERE"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1 0.8 0
        emissiveColor 0.3 0.2 0
        roughness 0.6
        metalness 0
      }
      geometry Box {
        size 0.35 0.35 0.005
      }
    }
  ]
}

# Service counter marker (visual only)
Solid {
  translation 3 -2 0.01
  name "CUE_QUEUE_SERVICE"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.2 0.8 0.3
        emissiveColor 0 0.3 0.1
        roughness 0.6
        metalness 0
      }
      geometry Box {
        size 0.35 0.35 0.005
      }
    }
  ]
}

# Exit area marker
Solid {
  translation 5 -6 0.02
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.8 0.3 0.2
        emissiveColor 0.3 0 0
        roughness 0.6
        metalness 0
      }
      geometry Cylinder {
        height 0.01
        radius 0.25
      }
    }
  ]
  name "ExitMarker"
}

# ---- Teacher robots (column formation — like a train) ----

# Teacher 1 (leader / engine)
Tiago {
  translation -4.0 -6.0 0.095
  rotation 0 0 1 0.78
  name "TIAGo_1"
  controller "tiago_social_layer"
  supervisor TRUE
  customData "-4.0,-6.0,0.0,0"
}

# Teacher 2 (follows T1)
Tiago {
  translation -4.0 -7.5 0.095
  rotation 0 0 1 0.78
  name "TIAGo_2"
  controller "tiago_social_layer"
  supervisor TRUE
  customData "-4.0,-7.5,0.0,1"
}

# Teacher 3 (follows T2)
Tiago {
  translation -4.0 -9.0 0.095
  rotation 0 0 1 0.78
  name "TIAGo_3"
  controller "tiago_social_layer"
  supervisor TRUE
  customData "-4.0,-9.0,0.0,2"
}

# ---- Learner robot (observes the train, learns the queue script) ----
Tiago {
  translation -4.0 -10.5 0.095
  rotation 0 0 1 0.78
  name "TIAGo_L"
  controller "tiago_social_layer"
  supervisor TRUE
  customData "-4.0,-10.5,0.0,3"
}
