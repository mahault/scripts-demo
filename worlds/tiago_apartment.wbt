# ====================================================================
# TIAGo robots for social-layer phase validation
#
# Phase 10 (table-clearing): robots start near different tables and
# coordinate clearing both tables via emergent ToM.
# customData format: goal_x,goal_y,alpha,agent_id,drop_x,drop_y
# ====================================================================

# Drop-off zone marker (kitchen counter area)
DEF DROP_OFF Solid {
  translation -2.0 -0.5 0.72
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.2 0.6 0.2
        roughness 0.8
        metalness 0
      }
      geometry Box {
        size 0.6 0.4 0.02
      }
    }
  ]
  name "drop_off_zone"
}

# TIAGo 1 - selfish (alpha=0.0)
# Starts in open living room area, south of coffee table
Tiago {
  translation -5.5 -3.0 0.095
  rotation 0 0 1 0.0
  name "TIAGo_1"
  controller "tiago_social_layer"
  supervisor TRUE
  customData "-1.0,-5.0,0.0,0,-2.0,-0.5"
}

# TIAGo 2 - empathic (alpha=6.0)
# Starts west of TIAGo_1, near coffee table area
Tiago {
  translation -6.5 -3.0 0.095
  rotation 0 0 1 3.14159
  name "TIAGo_2"
  controller "tiago_social_layer"
  supervisor TRUE
  customData "-7.2,-2.7,6.0,1,-2.0,-0.5"
}
